<Window x:Class="PackCircle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PackCircle"
        mc:Ignorable="d"
        FocusManager.FocusedElement="{Binding ElementName=FirstInput}"
        Title="Circles packer" Height="790" Width="800"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel, IsDesignTimeCreatable=True}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="15">
            <!-- Setup Inputs Go Here (Size, Qty, Width, etc.) -->
            <GroupBox Header="Setup"
                      FocusManager.IsFocusScope="True"
                      x:Name="SetupContainer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Circle size:" Margin="5"/>
                    <TextBox x:Name="FirstInput" Grid.Row="0" Grid.Column="1" Text="{Binding Size, Mode=TwoWay}" Margin="5"/>
                    <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding AvailableUnits}" Margin="5"
                              SelectedItem="{Binding SelectedUnit}" VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Circles quantity:" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Quantity, Mode=TwoWay}" Margin="5"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="pc(s)" Margin="5"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Space:" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Space, Mode=TwoWay}" Margin="5"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="5"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Sheet width:" Margin="5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Width, Mode=TwoWay}" Margin="5"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="5"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Sheet height:" Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Height, Mode=TwoWay}" Margin="5"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="5"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Sheet margin:" Margin="5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Margin, Mode=TwoWay}" Margin="5"/>
                    <Label Grid.Row="5" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="5"/>

                    <RadioButton Grid.Row="6" Grid.Column="0" Content="Full sheet" Margin="5">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <!-- Natively turns True if Enum equals FullSheet -->
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static local:SheetViewMode.FullSheet}">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <!-- When clicked, instantly pass the Enum value back to our property -->
                        <RadioButton.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static local:SheetViewMode.FullSheet}"/>
                        </RadioButton.InputBindings>
                    </RadioButton>
                    <RadioButton Grid.Row="6"  Grid.Column="1" Content="Last sheet" Margin="0 5">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <!-- Natively turns True if Enum equals LastSheet -->
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static local:SheetViewMode.LastSheet}">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <RadioButton.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static local:SheetViewMode.LastSheet}"/>
                        </RadioButton.InputBindings>
                    </RadioButton>

                    <!--<Button Grid.Row="6" Grid.Column="2" Content="Calculate" 
                            Command="{Binding CalculateCommand}" Margin="0,5"/>-->

                </Grid>
            </GroupBox>

            <GroupBox Header="Rectangular cut" IsEnabled="False">
                <GroupBox.Style>
                    <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}">
                        <Setter Property="Background" Value="White"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RectangularCut.IsBestChoice}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="#E8F5E9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Sheets:" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RectangularCut.Sheets}" Margin="5"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Quantity/Sheet:" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RectangularCut.CirclesOnSheet}" Margin="5"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Last sheet circles:" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RectangularCut.LastSheetCircles}" Margin="5"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Last sheet fill %:" Margin="5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RectangularCut.LastSheetPercent, Mode=OneWay, StringFormat=P1}" Margin="5"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Triangular cut" IsEnabled="False">
                <GroupBox.Style>
                    <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}">
                        <Setter Property="Background" Value="White"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TriangularCut.IsBestChoice}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="#E8F5E9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Sheets:" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TriangularCut.Sheets}" Margin="5"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Quantity/Sheet:" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TriangularCut.CirclesOnSheet}" Margin="5"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Last sheet circles:" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TriangularCut.LastSheetCircles}" Margin="5"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Last sheet fill %:" Margin="5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TriangularCut.LastSheetPercent, Mode=OneWay, StringFormat=P1}" Margin="5"/>
                </Grid>
            </GroupBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Close" 
                        Command="{Binding CloseApplicationCommand}"
                        Margin="10,10"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.Resources>
                <Style x:Key="CircleContainerStyle" TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                </Style>
                <DataTemplate x:Key="CircleTemplate">
                    <Ellipse Width="{Binding Diameter}"
                             Height="{Binding Diameter}"
                             Stroke="White"
                             StrokeThickness="1">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="White"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilled}"
                                                 Value="False">
                                        <Setter Property="Fill"
                                                Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </DataTemplate>
            </Grid.Resources>

            <UniformGrid Margin="10">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="2"/>
                        <Setter Property="Rows" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StackSheets}" Value="True">
                                <Setter Property="Columns" Value="1"/>
                                <Setter Property="Rows" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>

                <!-- PREVIEW 1: RECTANGULAR -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rectangular Cut Preview" FontWeight="Bold" FontSize="16" Margin="0,5"
                                   VerticalAlignment="Center"/>
                         <Button Content="Export centers" Margin="10,5"
                                Command="{Binding ExportCenterPositionsCommand}"
                                CommandParameter="Rectangular"/>
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#DDDDDD" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding RectangularCircles}"
                                  ItemContainerStyle="{StaticResource CircleContainerStyle}"
                                  ItemTemplate="{StaticResource CircleTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="#757575"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Viewbox>
                </Grid>

                <!-- PREVIEW 2: TRIANGULAR -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Triangular Cut Preview" FontWeight="Bold" FontSize="16" Margin="0,5"
                                   VerticalAlignment="Center"/>
                        <Button Content="Export centers" Margin="10,5"
                            Command="{Binding ExportCenterPositionsCommand}"
                            CommandParameter="Triangular"/>
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#DDDDDD" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding TriangularCircles}"
                                  ItemContainerStyle="{StaticResource CircleContainerStyle}"
                                  ItemTemplate="{StaticResource CircleTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="#757575"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Viewbox>
                </Grid>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
