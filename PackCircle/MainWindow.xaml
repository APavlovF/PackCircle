<Window x:Class="PackCircle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PackCircle"
        xmlns:models="clr-namespace:PackCircle.Models"
        mc:Ignorable="d"
        FocusManager.FocusedElement="{Binding ElementName=FirstInput}"
        Title="Circles packer" Height="790" Width="800"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel, IsDesignTimeCreatable=True}">

    <DockPanel>
        <Menu DockPanel.Dock="Top" 
              Background="{DynamicResource MaterialDesignPaper}" 
              TextBlock.Foreground="{DynamicResource MaterialDesignBody}">

            <MenuItem Header="_File">
                <MenuItem Header="Export Rectangular centers">
                    <MenuItem Header="CSV" Command="{Binding ExportCenterPositionsCommand}">
                        <MenuItem.CommandParameter>
                            <models:ExportParameter CutType="Rectangular" FileType="CSV" />
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="Excel" Command="{Binding ExportCenterPositionsCommand}">
                        <MenuItem.CommandParameter>
                            <models:ExportParameter CutType="Rectangular" FileType="Excel" />
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="Text file" Command="{Binding ExportCenterPositionsCommand}">
                        <MenuItem.CommandParameter>
                            <models:ExportParameter CutType="Rectangular" FileType="Text" />
                        </MenuItem.CommandParameter>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Export Triangular centers">
                    <MenuItem Header="CSV" Command="{Binding ExportCenterPositionsCommand}">
                        <MenuItem.CommandParameter>
                            <models:ExportParameter CutType="Triangular" FileType="CSV" />
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="Excel" Command="{Binding ExportCenterPositionsCommand}">
                        <MenuItem.CommandParameter>
                            <models:ExportParameter CutType="Triangular" FileType="Excel" />
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="Text file" Command="{Binding ExportCenterPositionsCommand}">
                        <MenuItem.CommandParameter>
                            <models:ExportParameter CutType="Triangular" FileType="Text" />
                        </MenuItem.CommandParameter>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit" Command="{Binding CloseApplicationCommand}"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="About" Command="{Binding ShowAboutInfoCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="15,5">
            <!-- Setup Inputs Go Here (Size, Qty, Width, etc.) -->
            <GroupBox Header="Setup"
                      FocusManager.IsFocusScope="True"
                      x:Name="SetupContainer">
                <GroupBox.Resources>
                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </GroupBox.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                    </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Circle size &#x00D8;:" Margin="3"/>
                    <TextBox x:Name="FirstInput" Grid.Row="0" Grid.Column="1" Text="{Binding Size, Mode=TwoWay}" Margin="3"/>
                    <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding AvailableUnits}" Margin="3"
                              SelectedItem="{Binding SelectedUnit}" VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Circles quantity:" Margin="3"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Quantity, Mode=TwoWay}" Margin="3"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="pc(s)" Margin="3"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Space:" Margin="3"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Space, Mode=TwoWay}" Margin="3"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="3"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Sheet width:" Margin="3"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Width, Mode=TwoWay}" Margin="3"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="3"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Sheet height:" Margin="3"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Height, Mode=TwoWay}" Margin="3"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="3"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Sheet margin:" Margin="3"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Margin, Mode=TwoWay}" Margin="3"/>
                    <Label Grid.Row="5" Grid.Column="2" Content="{Binding SelectedUnit}" Margin="3"/>

                    <RadioButton Grid.Row="6" Grid.Column="0" Content="Full sheet" Margin="3">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static local:SheetViewMode.FullSheet}">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <RadioButton.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static local:SheetViewMode.FullSheet}"/>
                        </RadioButton.InputBindings>
                    </RadioButton>
                    <RadioButton Grid.Row="6"  Grid.Column="1" Content="Last sheet" Margin="0 5">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static local:SheetViewMode.LastSheet}">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                        <RadioButton.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static local:SheetViewMode.LastSheet}"/>
                        </RadioButton.InputBindings>
                    </RadioButton>
                </Grid>
            </GroupBox>

            <GroupBox Header="Rectangular cut">
                <GroupBox.Resources>
                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </GroupBox.Resources>
                <GroupBox.Style>
                    <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="Margin" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RectangularCut.IsBestChoice}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="#E8F5E9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Sheets:" Margin="3"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RectangularCut.Sheets}" Margin="3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Quantity/Sheet:" Margin="3"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RectangularCut.CirclesOnSheet}" Margin="3"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Last sheet circles:" Margin="3"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RectangularCut.LastSheetCircles}" Margin="3"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Last sheet fill %:" Margin="3"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RectangularCut.LastSheetPercent, Mode=OneWay, StringFormat=P1}" Margin="3"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Triangular cut">
                <GroupBox.Resources>
                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </GroupBox.Resources>
                <GroupBox.Style>
                    <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="Margin" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TriangularCut.IsBestChoice}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="#E8F5E9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Sheets:" Margin="3"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TriangularCut.Sheets}" Margin="3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Quantity/Sheet:" Margin="3"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TriangularCut.CirclesOnSheet}" Margin="3"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Last sheet circles:" Margin="3"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TriangularCut.LastSheetCircles}" Margin="3"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Last sheet fill %:" Margin="3"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TriangularCut.LastSheetPercent, Mode=OneWay, StringFormat=P1}" Margin="3"/>
                </Grid>
            </GroupBox>

            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Close" 
                        Command="{Binding CloseApplicationCommand}"
                        Margin="0,5"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.Resources>
                <Style x:Key="CircleContainerStyle" TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                </Style>
                <DataTemplate x:Key="CircleTemplate">
                    <Ellipse Width="{Binding Diameter}"
                             Height="{Binding Diameter}"
                             Stroke="White"
                             StrokeThickness="1">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="White"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilled}"
                                                 Value="False">
                                        <Setter Property="Fill"
                                                Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </DataTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="275*"/>
                <RowDefinition Height="499*"/>
            </Grid.RowDefinitions>

            <UniformGrid Margin="10,0,10,10" Grid.RowSpan="2">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="2"/>
                        <Setter Property="Rows" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StackSheets}" Value="True">
                                <Setter Property="Columns" Value="1"/>
                                <Setter Property="Rows" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>

                <!-- PREVIEW 1: RECTANGULAR -->
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Rectangular Cut Preview" FontWeight="Bold" FontSize="16" Margin="0,5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#DDDDDD" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding RectangularCircles}"
                                  ItemContainerStyle="{StaticResource CircleContainerStyle}"
                                  ItemTemplate="{StaticResource CircleTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="#757575"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Viewbox>
                </Grid>

                <!-- PREVIEW 2: TRIANGULAR -->
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Triangular Cut Preview" FontWeight="Bold" FontSize="16" Margin="0,5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#DDDDDD" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding TriangularCircles}"
                                  ItemContainerStyle="{StaticResource CircleContainerStyle}"
                                  ItemTemplate="{StaticResource CircleTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="#757575"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Viewbox>
                </Grid>
            </UniformGrid>
        </Grid>
    </Grid>
        </DockPanel>
</Window>
